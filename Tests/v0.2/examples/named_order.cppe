int add3(int first, int second, int third = 30) {
    return first + second + third;
}

int add2(int first, int second = 20) {
    return first + second;
}

int main() {
    int a = add3(third=3, first=1, second=2);
    int b = add2(second=4, first=6);
    int c = add2(first=5);
    return (a == 6 && b == 10 && c == 25) ? 0 : 1;
}
